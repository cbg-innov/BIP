<macros>
    <!--
      TOOL_VERSION is the BIP release (git tag vX.Y.Z, GHCR image X.Y.Z) and also
      selects the container below. Bump VERSION_SUFFIX for wrapper-only changes.
      Release by tagging vX.Y.Z (TOOL_VERSION, suffix 0) or vX.Y.Z+galaxyN
      (suffix N); the release job checks the tag matches these two tokens.
    -->
    <token name="@TOOL_VERSION@">1.0.1</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">24.0</token>

    <xml name="requirements">
        <requirements>
            <!--
              BIP ships as a single self-contained image on GHCR that already
              bundles every R/Python/CLI dependency AND the reference libraries.
              Galaxy's ExplicitDockerContainerResolver picks this up directly
              (docker or singularity). Pinned to the release version rather than
              the mutable :latest tag, so each Tool Shed revision is reproducible.
            -->
            <container type="docker">ghcr.io/cbg-innov/bip:@TOOL_VERSION@</container>
        </requirements>
    </xml>

    <xml name="citations">
        <citations>
            <citation type="doi">10.64898/2026.07.21.739876</citation>
        </citations>
    </xml>
</macros>
